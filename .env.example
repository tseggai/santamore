# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── Organisation bank identity (Task 3, SEPA rail) ──────────────────────────
# Public facts (shown to every donor), but real values are never invented:
# the SEPA panel renders a placeholder state and no QR until these are set.
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_IBAN=
# Optional — the EPC QR uses payload v002, where BIC may be omitted.
NEXT_PUBLIC_ORG_BIC=

# ── Email (Task 3; Resend) ──────────────────────────────────────────────────
# Server-only. When unset, emails no-op with a log (dev/preview safe).
RESEND_API_KEY=
# Format: "Santamore <address@verified-sending-domain>".
EMAIL_FROM=

# ── Feature flags ───────────────────────────────────────────────────────────
# Task 4 turns the card rail on; until then the donate page is SEPA-only.
NEXT_PUBLIC_CARD_RAIL_ENABLED=false

# ── Monri (Task 4; documented now so envs hold no surprises) ────────────────
# Test: https://ipgtest.monri.com · Production: https://ipg.monri.com
MONRI_BASE_URL=https://ipgtest.monri.com
# Server-only. Never exposed.
MONRI_MERCHANT_KEY=
MONRI_AUTHENTICITY_TOKEN=
NEXT_PUBLIC_MONRI_BASE_URL=https://ipgtest.monri.com
# Needed client-side for Monri(); safe to expose.
NEXT_PUBLIC_MONRI_AUTHENTICITY_TOKEN=
PAYMENTS_LIVE=false
